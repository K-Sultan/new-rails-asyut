<%= form_with model: user do |form| %>
  <div>
    <%= form.label :name %><br>
    <%= form.text_field :name %>
  </div>
  <div>
    <%= form.label :DOB %><br>
    <%= form.date_field :DOB %>
  </div>
  <div>
    <%= form.label :email %><br>
    <%= form.email_field :email %>
  </div>
  <div>
    <%= form.label :phone_number %><br>
    <%= form.text_field :phone_number %>
  </div>
  <div>
    <%= form.label :address %><br>
    <%= form.text_field :address %>
  </div>
  <div>
    <%= form.submit %>
  </div>
<% end %>